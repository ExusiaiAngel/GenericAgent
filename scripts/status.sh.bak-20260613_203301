#!/bin/bash
# GenericAgent Status Monitor

ok_msg() { echo "[OK] $1"; }
fail_msg() { echo "[FAIL] $1"; }

check_svc() { systemctl is-active --quiet "$2" && ok_msg "$1" || fail_msg "$1"; }

echo '=============================='
echo ' GenericAgent Status Report'
echo "Time: $(date '+%Y-%m-%d %H:%M:%S')"
echo ''

check_svc 'Scheduler' 'genericagent'
check_svc 'NapCatQQ Frontend' 'genericagent-napcat'
pgrep -f 'xvfb-run.*qq' >/dev/null && ok_msg 'QQ Process' || fail_msg 'QQ Process'
ss -tlnp | grep -q ':3001' && ok_msg 'OneBot WS :3001' || fail_msg 'OneBot WS :3001'
ss -tlnp | grep -q ':6099' && ok_msg 'WebUI :6099' || fail_msg 'WebUI :6099'

echo ''
echo '-- Logs --'
echo '[NapCat] last 2:'
tail -2 /opt/GenericAgent/frontends/temp/napcat_qqapp.log 2>/dev/null | sed 's/^/  /'
echo '[Scheduler] last 2:'
journalctl -u genericagent --no-pager -n 2 2>/dev/null | tail -2 | sed 's/^/  /'

echo ''
free -h | awk '/^Mem:/ {print "Memory: "$3"/"$2}'
uptime -p
echo '=============================='
