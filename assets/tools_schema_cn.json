          "group_id": {
            "type": "string",
            "description": "群号"
          },
          "duration": {
            "type": "integer",
            "description": "[ban] 禁言时长（秒），默认600",
            "default": 600
          },
          "text": {
            "type": "string",
            "description": "[notice] 公告内容"
          }
        },
        "required": [
          "op",
          "group_id"
        ]
      }
    }
  }
]